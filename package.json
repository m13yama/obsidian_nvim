{
  "name": "obsidian-neovim",
  "version": "0.0.4",
  "private": true,
  "description": "Use a local Neovim process to edit notes in Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.2"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.18.0",
    "esbuild": "^0.25.9",
    "jsdom": "^26.1.0",
    "obsidian": "1.8.7",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
